# GHQリポジトリを一覧表示して開く
function ghq-fzf() {
  local src=$(ghq list | fzf --preview "ls -laTp $(ghq root)/{} | tail -n+4 | awk '{print \$9\"/\"\$6\"/\"\$7 \" \" \$10}'")
  if [ -n "$src" ]; then
    BUFFER="cd $(ghq root)/$src"
    zle accept-line
  fi
  zle -R -c
}
zle -N ghq-fzf
bindkey '^]' ghq-fzf

function tmux-help() {
  zle -I
  {
    echo ""
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║                   tmux チートシート                      ║"
    echo "╠══════════════════════════════════════════════════════════╣"
    echo "║  prefix = Ctrl+b                                         ║"
    echo "╠══════════════╦═══════════════════════════════════════════╣"
    echo "║ セッション    ║ :new-session / tmux new -s <name>        ║"
    echo "║               ║ d         デタッチ                       ║"
    echo "║               ║ \$         セッション名変更               ║"
    echo "║               ║ s         セッション一覧・切り替え        ║"
    echo "╠══════════════╬═══════════════════════════════════════════╣"
    echo "║ ウィンドウ    ║ c         新規ウィンドウ                  ║"
    echo "║               ║ ,         ウィンドウ名変更               ║"
    echo "║               ║ w         ウィンドウ一覧・切り替え        ║"
    echo "║               ║ n / p     次 / 前のウィンドウ            ║"
    echo "║               ║ 0-9       番号指定で切り替え              ║"
    echo "║               ║ &         ウィンドウを閉じる              ║"
    echo "╠══════════════╬═══════════════════════════════════════════╣"
    echo "║ 画面分割      ║ %         左右に分割                     ║"
    echo "║               ║ \"         上下に分割                     ║"
    echo "║               ║ x         ペインを閉じる                  ║"
    echo "║               ║ z         ペイン最大化トグル              ║"
    echo "║               ║ {  /  }   ペインを左右に移動              ║"
    echo "╠══════════════╬═══════════════════════════════════════════╣"
    echo "║ ペイン移動    ║ ← ↑ → ↓  矢印キーで移動               ║"
    echo "║               ║ o         次のペインへ                    ║"
    echo "║               ║ q         ペイン番号表示 → 番号キー       ║"
    echo "╠══════════════╬═══════════════════════════════════════════╣"
    echo "║ リサイズ      ║ Alt+←↑→↓   1セルずつリサイズ           ║"
    echo "║               ║ Ctrl+←↑→↓  5セルずつリサイズ           ║"
    echo "║               ║ :resize-pane -L/R/U/D <n>               ║"
    echo "║               ║ ※マウスドラッグも可 (mouse on 時)       ║"
    echo "╠══════════════╬═══════════════════════════════════════════╣"
    echo "║ コピーモード  ║ [         コピーモード開始 (vi操作)       ║"
    echo "║               ║ Space     選択開始  /  Enter  コピー      ║"
    echo "║               ║ ]         ペースト                        ║"
    echo "╠══════════════╬═══════════════════════════════════════════╣"
    echo "║ その他        ║ t         時計表示                        ║"
    echo "║               ║ ?         キー一覧                        ║"
    echo "║               ║ :         コマンドプロンプト              ║"
    echo "╚══════════════╩═══════════════════════════════════════════╝"
    echo ""
  } | less
  zle redisplay
}
zle -N tmux-help
bindkey '^t' tmux-help

function hideUserName() {
  PROMPT='%F{cyan}☻ @pc%f:%B%~%b %F{green}${vcs_info_msg_0_}%f
%# '
  zle reset-prompt
}
zle -N hideUserName
bindkey '^n' hideUserName