# GHQリポジトリを一覧表示して開く
function ghq-fzf() {
  local src=$(ghq list | fzf --preview "ls -laTp $(ghq root)/{} | tail -n+4 | awk '{print \$9\"/\"\$6\"/\"\$7 \" \" \$10}'")
  if [ -n "$src" ]; then
    BUFFER="cd $(ghq root)/$src"
    zle accept-line
  fi
  zle -R -c
}
zle -N ghq-fzf
bindkey '^]' ghq-fzf

function hideUserName() {
  PROMPT='%F{cyan}☻ @pc%f:%B%~%b %F{green}${vcs_info_msg_0_}%f
%# '
  zle reset-prompt
}
zle -N hideUserName
bindkey '^n' hideUserName