zi wait lucid atload"zicompinit; zicdreplay" blockf for zsh-users/zsh-completions

zi ice wait lucid atinit"ZI[COMPINIT_OPTS]=-C; zpcompinit; zpcdreplay"
zi light z-shell/F-Sy-H

zi ice wait lucid atload"!_zsh_autosuggest_start"
zi load zsh-users/zsh-autosuggestions

zstyle ":history-search-multi-word" page-size "11"
zi ice wait lucid
zi load z-shell/H-S-MW

zi pack"binary" for fzf

#zi ice wait lucid as"program" atinit"[[ -s \"$HOME/.gvm/scripts/gvm\" ]] && . \"$HOME/.gvm/scripts/gvm\"" \
#  atclone"./binscripts/gvm-installer" pick"$HOME/.gvm/bin/gvm"
#zi light moovweb/gvm

if (( ${+commands[go]} )); then
  zi ice wait lucid as"program" make pick"ghq"
  zi light x-motemen/ghq
fi
